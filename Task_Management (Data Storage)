void viewTasksByStatus(int status) {
    std::cout << "\n=== Tasks ===\n";
    printTasksByStatus(status);
}

// =============================
// TASK LOGIC IMPLEMENTATION
// =============================

void addTask(const std::string& title,
             const std::string& description,
             const std::string& deadline)
{
    Task t;
    t.id = nextTaskId++;
    t.title = title;
    t.description = description;
    t.deadline = deadline;
    t.status = TaskStatus::Pending;

    tasks.push_back(t);
}

bool editTask(int id) {
    for (auto& task : tasks) {
        if (task.id == id) {
            std::cout << "Editing task: " << task.title << "\n";

            std::string newTitle = getStringInput("New title (blank = no change): ");
            std::string newDesc  = getStringInput("New description (blank = no change): ");
            std::string newDeadline = getStringInput("New deadline (blank = no change): ");

            std::string statusIn = getStringInput("Status (P = pending, C = completed, blank = no change): ");

            if (!newTitle.empty()) task.title = newTitle;
            if (!newDesc.empty()) task.description = newDesc;
            if (!newDeadline.empty()) task.deadline = newDeadline;

            if (!statusIn.empty()) {
                char c = std::toupper(statusIn[0]);
                if (c == 'P') task.status = TaskStatus::Pending;
                else if (c == 'C') task.status = TaskStatus::Completed;
            }

            std::cout << "Updated.\n";
            return true;
        }
    }
    return false;
}

bool deleteTask(int id) {
    for (auto it = tasks.begin(); it != tasks.end(); ++it) {
        if (it->id == id) {
            tasks.erase(it);
            return true;
        }
    }
    return false;
}

void printTasksByStatus(int status) {
    if (tasks.empty()) {
        std::cout << "No tasks available.\n";
        return;
    }

    std::cout << std::left
              << std::setw(5) << "ID"
              << std::setw(20) << "Title"
              << std::setw(15) << "Deadline"
              << std::setw(12) << "Status"
              << "Description\n";

    std::cout << std::string(70, '-') << "\n";

    bool printed = false;

    for (const auto& task : tasks) {
        bool match =
            (status == 0) ||
            (status == 1 && task.status == TaskStatus::Pending) ||
            (status == 2 && task.status == TaskStatus::Completed);

        if (!match) continue;

        printed = true;

        std::cout << std::left
                  << std::setw(5) << task.id
                  << std::setw(20) << task.title.substr(0, 18)
                  << std::setw(15) << task.deadline
                  << std::setw(12) << (task.status == TaskStatus::Pending ? "Pending" : "Completed")
                  << task.description << "\n";
    }

    if (!printed)
        std::cout << "No tasks match this filter.\n";
}

// =============================
// FILE I/O IMPLEMENTATION (DATA MANAGEMENT ROLE)
// =============================

void loadTasksFromFile(const std::string& filename) {
    std::ifstream inFile(filename);
    
    if (!inFile.is_open()) {
        std::cout << "No existing task file found. Starting with empty task list.\n";
        return;
    }

    std::cout << "Loading tasks from " << filename << "...\n";
    
    Task task;
    std::string line;
    int tasksLoaded = 0;
    
    // Read file line by line
    while (std::getline(inFile, line)) {
        if (line.empty()) continue;
        
        std::stringstream ss(line);
        std::string token;
        std::vector<std::string> tokens;
        
        // Tokenize the line using | as delimiter
        while (std::getline(ss, token, '|')) {
            tokens.push_back(token);
        }
        
        // Expecting format: id|title|description|deadline|status
        if (tokens.size() >= 5) {
            task.id = std::stoi(tokens[0]);
            task.title = tokens[1];
            task.description = tokens[2];
            task.deadline = tokens[3];
            
            // Convert status string to enum
            if (tokens[4] == "Completed") {
                task.status = TaskStatus::Completed;
            } else {
                task.status = TaskStatus::Pending;
            }
            
            tasks.push_back(task);
            tasksLoaded++;
            
            // Update nextTaskId to be higher than any loaded ID
            if (task.id >= nextTaskId) {
                nextTaskId = task.id + 1;
            }
        }
    }
    
    inFile.close();
    std::cout << "Successfully loaded " << tasksLoaded << " tasks.\n";
}

void saveTasksToFile(const std::string& filename) {
    std::ofstream outFile(filename, std::ios::trunc); // Overwrite existing file
    
    if (!outFile.is_open()) {
        std::cout << "Error: Could not open file " << filename << " for writing.\n";
        return;
    }
    
    std::cout << "Saving " << tasks.size() << " tasks to " << filename << "...\n";
    
    for (const auto& task : tasks) {
        outFile << task.id << "|"
                << task.title << "|"
                << task.description << "|"
                << task.deadline << "|"
                << (task.status == TaskStatus::Completed ? "Completed" : "Pending")
                << "\n";
    }
    
    outFile.close();
    
    if (outFile.fail()) {
        std::cout << "Error: Failed to write to file.\n";
    } else {
        std::cout << "Tasks saved successfully.\n";
    }
}

bool backupTasks(const std::string& filename) {
    std::ofstream backupFile(filename);
    
    if (!backupFile.is_open()) {
        std::cout << "Error: Could not create backup file.\n";
        return false;
    }
    
    // Add backup header with timestamp
    backupFile << "# Task Management System Backup\n";
    backupFile << "# Generated by: " << currentUser << "\n";
    backupFile << "# Total tasks: " << tasks.size() << "\n";
    backupFile << "=================================\n";
    
    for (const auto& task : tasks) {
        backupFile << "ID: " << task.id << "\n";
        backupFile << "Title: " << task.title << "\n";
        backupFile << "Description: " << task.description << "\n";
        backupFile << "Deadline: " << task.deadline << "\n";
        backupFile << "Status: " << (task.status == TaskStatus::Completed ? "Completed" : "Pending") << "\n";
        backupFile << "---------------------------------\n";
    }
    
    backupFile.close();
    return true;
}

void displayFileStats(const std::string& filename) {
    std::cout << "\n=== File Statistics ===\n";
    std::cout << "Total tasks in memory: " << tasks.size() << "\n";
    
    std::ifstream inFile(filename);
    if (!inFile.is_open()) {
        std::cout << "No task file exists yet.\n";
        return;
    }
    
    // Count lines in file
    int lineCount = 0;
    std::string line;
    while (std::getline(inFile, line)) {
        if (!line.empty()) {
            lineCount++;
        }
    }
    inFile.close();
    
    std::cout << "Tasks in file: " << lineCount << "\n";
    
    // Calculate completion statistics
    int completed = 0, pending = 0;
    for (const auto& task : tasks) {
        if (task.status == TaskStatus::Completed) {
            completed++;
        } else {
            pending++;
        }
    }
    
    std::cout << "Completed tasks: " << completed << "\n";
    std::cout << "Pending tasks: " << pending << "\n";
    
    if (!tasks.empty()) {
        double completionRate = (static_cast<double>(completed) / tasks.size()) * 100;
        std::cout << "Completion rate: " << std::fixed << std::setprecision(1) << completionRate << "%\n";
    }
    
    pressEnterToContinue();
}
